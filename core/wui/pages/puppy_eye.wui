<Import name="AppLayout" from="../layouts/app" />

<AppLayout>
  <VStack spacing=10 padding=14 fill=true color="#d6eee9">
    <HStack spacing=8 wrap=true fill=true>
      <VStack spacing=2 grow=1 minWidth=0>
        <Text value="Puppy Eye" color="#eafff6" />
        <Text value="Live cameras detected across your PuppyNet devices." color="#9fbdb6" />
      </VStack>
      <Link text="Manage ONVIF cameras" href="/onvif-cameras" />
      <Button text="Refresh cameras" onClick="RefreshCameras" color="#79f2c0" backgroundColor="#020807" border="1px solid #2d6258" />
    </HStack>
    <Text value={state.puppy_eye_status} breakWords=true />
    <If test={!state.puppy_eye_has_cameras}>
      <VStack spacing=4 padding=14 fill=true backgroundColor="#061211" border="1px solid #2d6258">
        <Text value="No cameras detected." color="#eafff6" />
        <Text value="Connect a camera to a PuppyNet device, then refresh this page." color="#9fbdb6" />
      </VStack>
    </If>
    <Else>
      <HStack spacing=10 wrap=true fill=true>
        <For each={state.puppy_eye_cameras} itemAs="camera">
          <VStack spacing=6 padding=8 grow=1 minWidth=300 maxWidth=640 backgroundColor="#061211" border="1px solid #2d6258">
            <Image src={camera.stream_src} alt={camera.alt} maxWidth=624 maxHeight=351 objectFit="contain" onClick="OpenCamera" arg={camera.index} />
            <HStack spacing=6 wrap=true fill=true>
              <VStack spacing=2 grow=1 minWidth=0>
                <Link text={camera.camera_name} href={camera.view_href} />
                <Text value={camera.device_name} breakWords=true color="#79f2c0" />
                <Text value={camera.source_id} breakWords=true color="#9fbdb6" />
              </VStack>
              <Link text="View fullscreen" href={camera.view_href} />
              <Link text="Device" href={camera.device_href} />
            </HStack>
          </VStack>
        </For>
      </HStack>
    </Else>
  </VStack>
</AppLayout>

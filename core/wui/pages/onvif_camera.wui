<Import name="AppLayout" from="../layouts/app" />

<AppLayout>
  <VStack spacing=10 padding=14 fill=true color="#d6eee9">
    <HStack spacing=8 wrap=true fill=true>
      <VStack spacing=2 grow=1 minWidth=0>
        <Text value={state.onvif_viewer_name} breakWords=true color="#eafff6" />
        <Text value="ONVIF camera viewer" color="#9fbdb6" />
      </VStack>
      <Link text="Manage ONVIF cameras" href="/onvif-cameras" />
      <Link text="Puppy Eye" href="/puppy-eye" />
      <Button text="Refresh" onClick="RefreshCamera" color="#79f2c0" backgroundColor="#020807" border="1px solid #2d6258" />
    </HStack>
    <If test={!state.onvif_viewer_found}>
      <VStack spacing=4 padding=14 fill=true backgroundColor="#061211" border="1px solid #2d6258">
        <Text value="Camera not found." color="#ff8f8f" />
        <Text value="It may have been removed or its PuppyNet node may be unavailable." color="#9fbdb6" />
      </VStack>
    </If>
    <Else>
      <VStack spacing=8 padding=10 fill=true backgroundColor="#061211" border="1px solid #2d6258">
        <If test={state.onvif_viewer_enabled}>
          <Image src={state.onvif_viewer_stream_src} alt={state.onvif_viewer_name} maxWidth=1280 maxHeight=720 objectFit="contain" />
        </If>
        <Else>
          <Text value="This camera is disabled." color="#ffcf70" />
        </Else>
        <HStack spacing=8 wrap=true fill=true>
          <VStack spacing=2 grow=1 minWidth=240>
            <Text value={state.onvif_viewer_device_name} breakWords=true color="#79f2c0" />
            <Text value={state.onvif_viewer_device_service_url} breakWords=true color="#9fbdb6" />
            <Text value={state.onvif_viewer_profile_token} breakWords=true color="#9fbdb6" />
          </VStack>
          <Link text="Device" href={state.onvif_viewer_device_href} />
        </HStack>
      </VStack>
    </Else>
  </VStack>
</AppLayout>
